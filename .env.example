TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE
brand_name='ShyamX'
NEXT_PUBLIC_BRAND_NAME='ShyamX'

# ── AI (Groq) ─────────────────────────────────────────────────────────────────
# Groq powers chat / code / explain / summarize / facts / vision AND the whole
# AI Staff suite (AI AutoMod, AI Tasks, AI Task Checker, AI Staff Activity).
# Get free keys at: https://console.groq.com/keys
# ONE KEY PER LINE. The bot rotates all of them round-robin and automatically
# skips any key that is rate limited, out of quota, or invalid.
# 20 slots are provided below — fill as many as you have, delete the rest.
GROQ_API_KEY=gsk_your_key_1_here
GROQ_API_KEY_2=gsk_your_key_2_here
GROQ_API_KEY_3=gsk_your_key_3_here
GROQ_API_KEY_4=gsk_your_key_4_here
GROQ_API_KEY_5=gsk_your_key_5_here
GROQ_API_KEY_6=gsk_your_key_6_here
GROQ_API_KEY_7=gsk_your_key_7_here
GROQ_API_KEY_8=gsk_your_key_8_here
GROQ_API_KEY_9=gsk_your_key_9_here
GROQ_API_KEY_10=gsk_your_key_10_here
GROQ_API_KEY_11=gsk_your_key_11_here
GROQ_API_KEY_12=gsk_your_key_12_here
GROQ_API_KEY_13=gsk_your_key_13_here
GROQ_API_KEY_14=gsk_your_key_14_here
GROQ_API_KEY_15=gsk_your_key_15_here
GROQ_API_KEY_16=gsk_your_key_16_here
GROQ_API_KEY_17=gsk_your_key_17_here
GROQ_API_KEY_18=gsk_your_key_18_here
GROQ_API_KEY_19=gsk_your_key_19_here
GROQ_API_KEY_20=gsk_your_key_20_here
# Comma-separated on one line also works:
# GROQ_API_KEY=gsk_key1,gsk_key2,gsk_key3

# Optional model overrides (defaults are fine)
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# AutoMod cost control (optional). The automod uses a cheap/fast model and a
# hard per-minute call budget so it never drains your daily quota.
# AI_AUTOMOD_MODEL=llama-3.1-8b-instant
# AI_AUTOMOD_MAX_PER_MIN=20

# You can also add/remove/check keys from Discord at runtime (bot owner only):
#   aikeys add gsk_xxx           (or attach a .txt / .env file)
#   aikeys health                (live check every key)
#   aikeys list / remove / rotate / use / reload
# Keys added this way are saved to data/groq_keys.json and used immediately.

# ── Legacy Gemini (no longer used — kept for reference only) ─────────────────
# GOOGLE_API_KEY=

# ── Stats / Log Channels (Discord channel IDs — set to your own server) ──────
SERVER_COUNT_CHANNEL_ID=0
USER_COUNT_CHANNEL_ID=0
LOG_CHANNEL_ID=0

# ── Owner / Staff IDs (comma-separated Discord user IDs) ──────────────────────
# Edit this list — no code changes needed anywhere else
OWNER_IDS=994908472812507197

# ── Lavalink ──────────────────────────────────────────────────────────────────
LAVALINK_HOST="lavalink.jirayu.net"
LAVALINK_PASSWORD="youshallnotpass"

# Set to true if the node uses HTTPS/WSS (secure), false for HTTP/WS
LAVALINK_SECURE="false"

# Only needed when LAVALINK_SECURE is false (e.g. 2333)
LAVALINK_PORT="13592"

# ── Emoji Sync ────────────────────────────────────────────────────────────────
# Set to true to enable automatic application emoji sync on startup
EMOJI_SYNC="true"

# ── API / Dashboard Backend ───────────────────────────────────────────────────
# Set to true to enable the dashboard API server
API_ENABLED="false"
# Port the API server listens on
API_PORT="8000"
DASHBOARD_API_KEY="CHANGE_THIS_TO_A_LONG_RANDOM_STRING"
# Extra CORS-allowed origins, comma-separated (optional)
CORS_ORIGINS=""

#  CODEX DEVS

# ── Webhooks ──────────────────────────────────────────────────────────────────
WEBHOOK_URL="https://discord.com/api/webhooks/"
CMD_WEBHOOK_URL="https://discord.com/api/webhooks/"


# ── Cloudflare Tunnel For API Server ─────────────────────────────────────────────────────────
#
# How to get CF_TUNNEL_TOKEN (browser only, no CLI):
#   1. Go to https://one.dash.cloudflare.com
#   2. Networks → Tunnels → Create a tunnel → Choose "Cloudflared"
#   3. Give it a name (e.g. zyrox-api) and save
#   4. On the "Install connector" step, copy the token from the shown command:
#         cloudflared tunnel run --token <COPY_THIS_TOKEN>
#   5. Go to "Published Application Routes" tab → Add a Published Application Routes:
#         Subdomain: zyrox-api   Domain: yourdomain.com   Service: http://localhost:8000
#   6. Paste the token below — that's it. Permanent URL, unlimited traffic.
#
TUNNEL_ENABLED="true"
CF_TUNNEL_TOKEN="xxx_xxxx"
CF_TUNNEL_URL="https://zyrox-api.yourdomain.com"
